{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarToDo",
  "version": "0.1.2",
  "identifier": "com.aidotnet.startodo",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["startodo"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run build:notification-host && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:notification-host && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "StarToDo",
        "visible": false,
        "width": 960,
        "height": 680,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../tools/notification-host/publish/StarToDo.NotificationHost.exe": "notification-host/StarToDo.NotificationHost.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/notification-host-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
